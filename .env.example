# Server settings (copy to .env)
PORT=4000
# mongo, memory, or firestore
DB_DRIVER=mongo
MONGO_URI=mongodb://127.0.0.1:27017/barnes_spring

# Firebase / Firestore settings
# Set DB_DRIVER=firestore and provide either a project ID plus ADC credentials,
# or FIRESTORE_EMULATOR_HOST for local emulator testing.
FIREBASE_PROJECT_ID=barnes-spring-renovations
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Load sample data on first start if the database is empty
SEED_ON_START=false
